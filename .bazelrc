build --features=-supports_start_end_lib
build --enable_platform_specific_config
#build --copt=-ffunction-sections
#build --copt=-fdata-sections
#build --linkopt=-Wl,--gc-sections
# `-std=gnu99` is a GCC spelling. It used to sit here unconditionally, so cl.exe was handed
# it as well and answered `D9002: ignoring unknown option '-std=gnu99'` on every single C
# compile. It now lives in the `linux` / `macos` configs (activated by
# --enable_platform_specific_config above); Windows gets `/std:c11` from the `windows`
# config further down instead.
build --@mbedtls//:mbedtls_config=//src:mbedtls_config

# SQLite compile options (session state persistence). The BCR module compiles sqlite3.c with
# SQLite's stock defaults, which are wrong for us on two counts, so the flags are injected
# per-file here instead of patching the module:
#   SQLITE_DQS=0                 stock is 3: a double-quoted string that does not name a
#                                column silently becomes a string literal, so a typo in our
#                                hand-written DDL turns into wrong data instead of an error.
#   SQLITE_OMIT_LOAD_EXTENSION   the workspace is a model-writable directory; extension
#                                loading must not even be linkable (runtime default is off,
#                                but the code would still be there to be switched on).
# Deliberately NOT set:
#   SQLITE_DEFAULT_MEMSTATUS=0   would drop a global mutex from every sqlite3Malloc(), but
#                                that cost is unmeasurable next to our real bottleneck (the
#                                ~90% cJSON print) and it permanently disables
#                                sqlite3_status()/memory_used()/soft_heap_limit64(), which a
#                                future `edgeclaw db` diagnostics subcommand would want.
#                                Stock it is.
#   SQLITE_THREADSAFE            left at the stock 1: the store is driven from the scheduler
#                                thread, and a future multi-process/thread reader must not be
#                                silently unsupported.
# The regex matches the file name only, so it does not depend on bzlmod's canonical repo
# name (external/sqlite3+/...). A wrong regex would silently produce an UNHARDENED library,
# which is why tests/test_sqlite_hardening asserts the options via
# sqlite3_compileoption_used() -- keep the two in sync.
build --per_file_copt='sqlite3\.c$@-DSQLITE_DQS=0,-DSQLITE_OMIT_LOAD_EXTENSION'

# Pure C project: override default link_libs to exclude -lstdc++
# Scoped to Linux/macOS: `-lm` is a GNU-driver spelling. MSVC links the CRT by default and
# has no libm to name, so handing this to link.exe would only produce errors.
build:linux --repo_env=BAZEL_LINKLIBS=-lm
build:macos --repo_env=BAZEL_LINKLIBS=-lm

# Fix hedron_compile_commands' C++ helper binary linking (pure C project lacks -lstdc++)
build:cc --linkopt=-lstdc++

build:dbg --compilation_mode=dbg
build:dbg --copt=-g
build:dbg --strip=never

# ── Linux / macOS: GNU toolchains ────────────────────────────────────────────
# The gcc/clang language level for C sources. Linux/macOS only -- see the note at the top
# where `-std=gnu99` used to be unconditional.
build:linux --conlyopt=-std=gnu99
build:macos --conlyopt=-std=gnu99

# ── C++ exceptions are off ───────────────────────────────────────────────────
# Nothing in this tree throws or catches: `grep -rn 'throw \|catch *(' src/` returns only
# comments. The C parts are compiled as C, and the C++ is a handful of TUI files plus ftxui,
# which does not throw either.
#
# Turning them off is not a micro-optimisation, it is what makes coverage instrumentation
# honest. With -fexceptions, gcc emits a branch for the unwind path of every temporary with a
# non-trivial destructor, and marks it `(throw)` in the profile. Those branches cannot be
# taken -- there is no throw to reach them -- so every C++ line using a temporary reports as
# partially covered forever. Measured on this tree: edc_setup_dialog.cpp is 99.6% covered by
# line and still has 73 of its 115 branch-carrying lines scored as partial, and the diff
# coverage of an ordinary C++ change loses ~30 points to it (74.2% by line, 42.6% as
# Codecov scores it).
#
# The cost is that an unforeseen exception -- a bad_alloc, or a std::filesystem call without
# an error_code -- aborts instead of unwinding. That is a real behaviour change, so the code
# that could do it uses the non-throwing overloads; see the note in tests/test_tui_dispatch.cpp.
build:linux --cxxopt=-fno-exceptions
build:macos --cxxopt=-fno-exceptions
build:linux --host_cxxopt=-fno-exceptions
build:macos --host_cxxopt=-fno-exceptions

# ── Windows: MSVC ────────────────────────────────────────────────────────────
# MinGW is not supported. The `@mingw_toolchain` extension and its
# `--extra_toolchains` line used to live here; both are gone, so Bazel falls back to its
# own autodetected MSVC toolchain on a Windows host (see the note in MODULE.bazel).
# `--repo_env=PATH` went with them: it existed only so the MinGW repository rule could
# find gcc on PATH, and it has no meaning for MSVC.
build:windows --copt=/utf-8
build:windows --host_copt=/utf-8
# C++ exceptions off, MSVC spelling. See the -fno-exceptions block above for why: nothing here
# throws, and the unwind branches a compiler emits for them can never be covered. /EH- also
# stops cl from assuming it may unwind, which is what removes the same instrumentation.
build:windows --cxxopt=/EH-
build:windows --host_cxxopt=/EH-
# Static CRT, for the same reason the MinGW build passed `-static`: the release archive ships
# only edgeclaw.exe, so anything it imports besides Windows itself would be a missing
# dependency on a clean machine. cl links VCRUNTIME140.dll by default; /MT (Bazel's
# `static_link_msvcrt` feature) puts that runtime inside the binary instead. The UCRT
# api-ms-win-crt-* DLLs remain dynamic, which is correct -- they are part of Windows 10+.
build:windows --features=static_link_msvcrt
build:windows --host_features=static_link_msvcrt
# `_Static_assert` (src/common/edc_platform.c) and the C99 designated initializers used
# throughout need C11; MSVC's default C mode is C89 and rejects both.
build:windows --conlyopt=/std:c11


# ── macOS: pin the deployment target ─────────────────────────────────────────
# Without this, the minimum OS is whatever the build machine's SDK says it is, and
# the macOS release job builds on `macos-14` (see .github/workflows/release.yml) --
# so the shipped binary demanded macOS 14 and refused to start on anything older.
# Apple Silicon itself starts at 11.0, so 11.0 is the floor available to us; it buys
# three major versions of headroom over the status quo.
#
# Both halves are needed and they must agree. Linking alone would only stamp the
# value into LC_BUILD_VERSION; the object files would still be compiled against the
# SDK default, and ld warns "object file was built for newer macOS version than
# being linked". Compiling alone would leave the load command unset.
#
# macOS now uses apple_support's cc toolchain (see MODULE.bazel, which also explains
# why: newer Xcode must not let the SDK's SDKSettings.json count as a non-builtin
# absolute include). That toolchain expands %{macos_minimum_os} into the `-target`
# triple, so the Bazel flag is what sets the floor: `--macos_minimum_os=11.0` turns
# `-target arm64-apple-macosx27.0` into `...macosx11.0`. It is needed for both the
# compile and the link; the `-mmacosx-version-min` pair stays as a belt-and-braces
# spelling that also works if resolution ever falls back to the autodetected
# toolchain, which ignores this flag.
#
# `build:macos` is activated by --enable_platform_specific_config (line 2) from the
# HOST os, so it applies on the macOS runner and is inert everywhere else. Tests get
# it too, which is what we want: a test binary built for 14.0 would not run on 11.0.
#
# Verified by the "Verify macOS minimum OS" step in release.yml.
build:macos --macos_minimum_os=11.0
build:macos --copt=-mmacosx-version-min=11.0
build:macos --linkopt=-mmacosx-version-min=11.0

# Code coverage (GCC + gcov). The toolchains' "coverage" feature is what actually adds
# -fprofile-arcs/-ftest-coverage/--coverage; see toolchain/compilation_mode_features.bzl
# for why a hand-rolled cc_toolchain config needs it spelled out.
# --instrumentation_filter defaults to "^//tests[/:]", i.e. the report would describe the
# tests and report ~0 for every line of src/. Pin it here so `bazel coverage` is
# reproducible without remembering the flag:
#   bazel coverage --config=cov //tests/...
build:cov --collect_code_coverage
build:cov --instrumentation_filter=//src

# ── AddressSanitizer + UndefinedBehaviorSanitizer ─────────────────────────────
# `bazel test //tests:all --config=asan`: the branches ordinary tests do not reach -- a
# use-after-free on an error path, an overflow in a length calculation -- surface here as a
# crash instead of as a plausible-looking result. This is the only job that exercises
# failure paths, so it is deliberately part of the release gate, not an optional extra.
#
# Must NOT carry -static (ASAN needs a dynamic runtime). That is fine because only the
# SHIPPED binaries add -static, through their own LINK_OPTS; `//tests:...` targets do not.
build:asan --compilation_mode=dbg
build:asan --strip=never
build:asan --define=sanitize=1
build:asan --copt=-g
build:asan --copt=-fsanitize=address,undefined
build:asan --copt=-fno-omit-frame-pointer
build:asan --linkopt=-fsanitize=address,undefined
# Leak detection stays off: several tests fork or hold a store open on purpose, so a leak
# report there is noise. ASAN's memory errors and UBSAN's findings still abort the run.
test:asan --test_env=ASAN_OPTIONS=detect_leaks=0:abort_on_error=1:print_stacktrace=1
test:asan --test_env=UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1
# lwIP does pointer arithmetic that assumes natural alignment and trips UBSAN's alignment
# check in several files (memp.c:195, pbuf.c:181, ...). It is third-party code we do not
# patch, and the finding is about lwIP's own buffer layout rather than our use of it, so the
# check is disabled for that library -- not globally: an unaligned access in OUR code stays
# visible, which is where the check has something to say.
build:asan --per_file_copt='.*lwip/src/.*\.c$@-fno-sanitize=alignment'

# ── musl: fully static release binaries ──────────────────────────────────────
# `bazel build --config=musl_aarch64 --compilation_mode=opt //:edgeclaw` produces a
# binary linked against musl libc instead of glibc. It is the same program; the
# difference is what gets linked in:
#
#   glibc  9.93 MB, 3 "Using 'getpwuid_r' in statically linked applications"
#                  -style link warnings
#   musl   8.26 MB, 0 link warnings
#
# This is opt-in by design. The development loop, `bazel test`, `--config=asan` and
# valgrind all stay on glibc, and nothing here is registered as a global toolchain,
# so a machine with no musl compiler builds exactly as it did before. Three reasons
# not to make it the default:
#
#   1. A musl toolchain ships no libasan/libubsan, so `--config=asan` -- part of the
#      release gate, the only job that exercises failure paths -- cannot run under
#      musl. Do not combine the two; asan must stay glibc.
#   2. The host glibc is better tested on the dev machines that run the tests.
#   3. musl has no dlopen at all when statically linked.
#
# `--extra_toolchains` rather than `register_toolchains()`: extra toolchains take
# priority over registered ones AND are only in play when the flag is passed, which
# is precisely the "release only" semantics wanted here.
#
# The toolchain is found automatically under /opt or on PATH, or pointed at
# explicitly with MUSL_CROSS_COMPILE_<ARCH>=/path/to/bin/<triple>- .
# If none is found the build fails with an explanation and nothing else changes.
#
# Inside edgeclaw's own sandboxed shell /opt must be on the read-only list, because the
# kernel denies exec of a path it cannot read: without it the first compile fails with
# `execvp(/opt/.../<triple>-gcc, ...): Permission denied`. /opt is in the default
# whitelist (see EDC_SANDBOX_DEFAULT_RO_PATHS); an existing config.json predates it, so
# add it once with `/sandbox add-ro /opt` -- and `bazel shutdown` afterwards, since a
# running server keeps the Landlock ruleset it was started with.
#
# NOTE: pass --compilation_mode=opt (or reuse a release config) when you want the
# shipped artifact; the default fastbuild produces a much larger binary.
#
# NOTE: do NOT also pass --platforms=//:<arch>_linux. The flag on the command line
# wins over the one here, so the build would silently go back to glibc. These
# configs exist so that `--config=musl_<arch>` alone is the whole story.
build:musl_aarch64 --platforms=//:aarch64_linux_musl
build:musl_aarch64 --extra_toolchains=@musl_toolchain_aarch64//:aarch64_linux_musl_toolchain

build:musl_arm --platforms=//:arm_linux_musl
build:musl_arm --extra_toolchains=@musl_toolchain_arm//:arm_linux_musl_toolchain

build:musl_amd64 --platforms=//:amd64_linux_musl
build:musl_amd64 --extra_toolchains=@musl_toolchain_amd64//:amd64_linux_musl_toolchain
