+// TEMPORARY DIAGNOSTIC: append one line per console input record, per parser decision and
+// per parsed event to %TEMP%/edc_input_trace.log. Off unless EDGECLAW_INPUT_TRACE=1.
+// Remove once the ConPTY input path is settled.
+namespace {
+void InputTrace(const std::string& line) {
+  if (std::getenv("EDGECLAW_INPUT_TRACE") == nullptr) {
+    return;
+  }
+  const char* temp = std::getenv("TEMP");
+  const std::string path = std::string(temp != nullptr ? temp : ".") +
+                           "/edc_input_trace.log";
+  FILE* file = std::fopen(path.c_str(), "ab");
+  if (file == nullptr) {
+    return;
+  }
+  const auto now = std::chrono::duration_cast<std::chrono::milliseconds>(
+                       std::chrono::steady_clock::now().time_since_epoch())
+                       .count();
+  std::fprintf(file, "%lld %s\n", static_cast<long long>(now), line.c_str());
+  std::fclose(file);
+}
+
+std::string HexBytes(const std::string& bytes) {
+  static const char* digits = "0123456789abcdef";
+  std::string out;
+  for (const char c : bytes) {
+    const auto value = static_cast<unsigned>(static_cast<unsigned char>(c));
+    out += digits[value >> 4U];
+    out += digits[value & 0x0fU];
+    out += ' ';
+  }
+  if (!out.empty()) {
+    out.pop_back();
+  }
+  return out;
+}
