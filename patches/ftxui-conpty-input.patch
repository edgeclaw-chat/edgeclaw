+        // expand every non-ASCII byte a second time: 鐜?(E7 8E B0) became U+00E7 U+008E
+        // U+00B0. Such a batch already IS the original UTF-8 stream, so its bytes go to
+        // utf8_bytes_ and are handed on as whole sequences only -- a partial sequence
+        // left in the parser is flushed as Event::Special after 50ms without input, which
+        // silently dropped characters. Anything above 0xFF came from a console that
+        // reports real UTF-16 and keeps the to_string() path.
+        bool byte_units = true;
+        for (const wchar_t unit : wstring) {
+          if (unit < 0 || unit > 0xff) {
+            byte_units = false;
+            break;
+          }
+        }
+        if (!byte_units) {
+          for (auto it : to_string(wstring)) {
+            terminal_input_parser.Add(it);
+          }
+        } else {
+          for (const wchar_t unit : wstring) {
+            utf8_bytes_ += static_cast<char>(unit);
+          }
+          while (!utf8_bytes_.empty()) {
+            const auto lead = static_cast<unsigned char>(utf8_bytes_[0]);
+            size_t length = 1;
+            if (lead >= 0xf0) {
+              length = 4;
+            } else if (lead >= 0xe0) {
+              length = 3;
+            } else if (lead >= 0xc0) {
+              length = 2;
+            } else if (lead >= 0x80) {
