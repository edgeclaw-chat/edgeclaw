diff --git a/sds.h b/sds.h
index adcc12c..a067487 100644
--- a/sds.h
+++ b/sds.h
@@ -40,38 +40,77 @@ extern const char *SDS_NOINIT;
 #include <stdarg.h>
 #include <stdint.h>
 
+/* MSVC provides neither <unistd.h> nor a ssize_t in <sys/types.h>, and the declarations at
+ * the bottom of this header are written in terms of ssize_t.
+ *
+ * SSIZE_MAX has to come with it: lwIP's <lwip/arch.h> does
+ *     #ifdef SSIZE_MAX ... #else typedef int ssize_t; #endif
+ * and MSVC defines no SSIZE_MAX, so including that header after this one made lwIP typedef
+ * ssize_t as `int` on top of the __int64 above -- error C2371: redefinition; different basic
+ * types. Supplying the macro is also simply correct: POSIX puts SSIZE_MAX in <limits.h>. */
+#ifdef _MSC_VER
+#ifndef SSIZE_MAX
+typedef __int64 ssize_t;
+#define SSIZE_MAX INT64_MAX
+#endif
+#endif
+
 typedef char *sds;
 
+/* `__attribute__((packed))` is GCC/Clang-only. MSVC spells the same layout
+ * `#pragma pack(push, 1)`, and the two agree byte for byte here: sdshdr8/16/32/64 occupy
+ * 3/5/9/17 bytes either way. That equality is what matters -- sds.c's SDS_HDR() walks
+ * backwards from the payload by the size of these headers. */
+#ifdef _MSC_VER
+#define SDS_PACK_BEGIN __pragma(pack(push, 1))
+#define SDS_PACK_END __pragma(pack(pop))
+#define SDS_STRUCT(name) struct name
+#else
+#define SDS_PACK_BEGIN
+#define SDS_PACK_END
+#define SDS_STRUCT(name) struct __attribute__ ((__packed__)) name
+#endif
+
 /* Note: sdshdr5 is never used, we just access the flags byte directly.
  * However is here to document the layout of type 5 SDS strings. */
-struct __attribute__ ((__packed__)) sdshdr5 {
+SDS_PACK_BEGIN
+SDS_STRUCT(sdshdr5) {
     unsigned char flags; /* 3 lsb of type, and 5 msb of string length */
     char buf[];
 };
-struct __attribute__ ((__packed__)) sdshdr8 {
+SDS_PACK_END
+SDS_PACK_BEGIN
+SDS_STRUCT(sdshdr8) {
     uint8_t len; /* used */
     uint8_t alloc; /* excluding the header and null terminator */
     unsigned char flags; /* 3 lsb of type, 5 unused bits */
     char buf[];
 };
-struct __attribute__ ((__packed__)) sdshdr16 {
+SDS_PACK_END
+SDS_PACK_BEGIN
+SDS_STRUCT(sdshdr16) {
     uint16_t len; /* used */
     uint16_t alloc; /* excluding the header and null terminator */
     unsigned char flags; /* 3 lsb of type, 5 unused bits */
     char buf[];
 };
-struct __attribute__ ((__packed__)) sdshdr32 {
+SDS_PACK_END
+SDS_PACK_BEGIN
+SDS_STRUCT(sdshdr32) {
     uint32_t len; /* used */
     uint32_t alloc; /* excluding the header and null terminator */
     unsigned char flags; /* 3 lsb of type, 5 unused bits */
     char buf[];
 };
-struct __attribute__ ((__packed__)) sdshdr64 {
+SDS_PACK_END
+SDS_PACK_BEGIN
+SDS_STRUCT(sdshdr64) {
     uint64_t len; /* used */
     uint64_t alloc; /* excluding the header and null terminator */
     unsigned char flags; /* 3 lsb of type, 5 unused bits */
     char buf[];
 };
+SDS_PACK_END
 
 #define SDS_TYPE_5  0
 #define SDS_TYPE_8  1
