module(
    name = "edgeclaw",
    version = "1.0.0",
    repo_name = "edgeclaw"
)

arm_toolchain = use_extension("//:extensions.bzl", "arm_toolchain")
use_repo(arm_toolchain, "arm_toolchain")
register_toolchains("@arm_toolchain//:arm_linux_toolchain")

aarch64_toolchain = use_extension("//:extensions.bzl", "aarch64_toolchain")
use_repo(aarch64_toolchain, "aarch64_toolchain")
register_toolchains("@aarch64_toolchain//:aarch64_linux_toolchain")

aarch64_android_toolchain = use_extension("//:extensions.bzl", "aarch64_android_toolchain")
use_repo(aarch64_android_toolchain, "aarch64_android_toolchain")
register_toolchains("@aarch64_android_toolchain//:aarch64_android_toolchain")

arm_android_toolchain = use_extension("//:extensions.bzl", "arm_android_toolchain")
use_repo(arm_android_toolchain, "arm_android_toolchain")
register_toolchains("@arm_android_toolchain//:arm_android_toolchain")

mingw_toolchain = use_extension("//:extensions.bzl", "mingw_toolchain")
use_repo(mingw_toolchain, "mingw_toolchain")
register_toolchains("@mingw_toolchain//:mingw_windows_toolchain")

# musl toolchains for the fully static Linux release binaries. Intentionally not
# registered: they are selected by `--config=musl_<arch>`, which passes
# --extra_toolchains. Registering them would make them compete with the glibc
# toolchain on every ordinary build for no gain.
musl_toolchain = use_extension("//:extensions.bzl", "musl_toolchain")
use_repo(
    musl_toolchain,
    "musl_toolchain_aarch64",
    "musl_toolchain_arm",
    "musl_toolchain_amd64",
)

# Hermetic Python toolchain: rules_python downloads its own Python 3.8, so no system
# Python is required by any build step that runs a py_binary (//tools:gen_models,
# embed_models, embed_workspace, gen_version). Verified with `sys.executable` from inside
# a target: it resolves to .../python_3_8_aarch64-unknown-linux-gnu/bin/python3, 3.8.20.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.8", is_default = True)
use_repo(python, "python_3_8")

# Do NOT also register @bazel_tools//tools/python:autodetecting_toolchain here. It used
# to be registered as a "fallback for cross-compilation" with a comment claiming Bazel
# would prefer the hermetic toolchain for native builds. That was not true: the
# autodetecting toolchain matches unconditionally, so it WON every resolution, and every
# py_binary silently ran on whatever system python happened to be on PATH (3.14.4 here,
# not 3.8). It also defeats the point of pinning -- two machines with different system
# pythons would run the build tools on different interpreters.
#
# Without it, toolchain resolution picks the hermetic one for the host, which is what
# the cross-compilation builds want too: a py_binary is a build-time tool, so it runs on
# the EXECUTION platform (the host), never on the target being cross-compiled. Verified
# against --platforms=//:arm_linux and a full `bazel build //src/tui:edgeclaw
# //:device_agent`.

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "mbedtls", version = "3.6.5")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "ftxui", version = "7.0.0")

# Windows Terminal and VS Code run the TUI under ConPTY, which hands the console the
# user's typed text as raw UTF-8 *bytes*. ftxui decoded those byte values as code points
# and re-encoded them, so every non-ASCII character arrived double-encoded (现 = E7 8E B0
# became "ç" + U+008E + "°") and that mojibake got stored, logged and sent to the model.
# The patch feeds such byte-valued input to the UTF-8 parser unchanged; real UTF-16 from
# a classic conhost keeps the original path. The same patch turns ENABLE_PROCESSED_INPUT
# off, so Ctrl+C arrives as the 0x03 byte (Event::CtrlC) instead of a CTRL_C_EVENT the CRT
# turns into SIGINT -- the same effect the POSIX branch gets by clearing ISIG.
single_version_override(
    module_name = "ftxui",
    version = "7.0.0",
    patches = ["//patches:ftxui-conpty-input.patch"],
    patch_strip = 1,
)

# POSIX regex (regcomp/regexec) for Windows, where no system <regex.h> exists.
# PCRE2 ships a POSIX-compatible wrapper (pcre2posix.h) used only on Windows;
# other platforms keep using the system regex.
bazel_dep(name = "pcre2", version = "10.49")

bazel_dep(name = "cjson", version = "1.7.19-0.20240923110858-12c4bf1986c2.bcr.4")

# Session state persistence.
# The BCR module ships SQLite's stock compile options, which this project cannot use as-is
# (DQS=3, load_extension() compiled in, memstat=1, a global mutex per allocation). Those are
# injected from .bazelrc with --per_file_copt rather than by patching the module's BUILD --
# the same place the mbedtls config is customised. tests/test_sqlite_hardening asserts they
# actually took effect.
bazel_dep(name = "sqlite3", version = "3.53.4")

bazel_dep(name = "rules_python", version = "1.7.0")

# Hedron's Compile Commands Extractor for Bazel
# https://github.com/hedronvision/bazel-compile-commands-extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    # Replace the commit hash (above) with the latest (https://github.com/hedronvision/bazel-compile-commands-extractor/commits/main).
    # Even better, set up Renovate and let it do the work for you (see "Suggestion: Updates" in the README).
)

bc_thirdparty_deps = use_extension("//:extensions.bzl", "bc_thirdparty_deps")
use_repo(
    bc_thirdparty_deps,
    "log.c",
    "ccronexpr",
    "md4c",
    "lwip",
    "sds",
    "uthash",
    "libuv",
    "llhttp",
    "libyuarel",
)
